# ===================================================================
# ハゼモト業務アプリ 環境変数テンプレート
# 実際の値を埋めて .env として配置してください
# ===================================================================

# --- 必須：データベース接続 -----------------------------------------
DATABASE_URL=mysql://user:password@mysql:3306/hazemoto

# --- 必須：セッションCookieの署名鍵 ---------------------------------
# 32文字以上のランダム文字列を生成してください
# 例: openssl rand -hex 32
JWT_SECRET=replace_me_with_32+_random_chars

# --- 必須：アプリ識別子・タイトル -----------------------------------
VITE_APP_ID=hazemoto-business
VITE_APP_TITLE=ハゼモト業務

# --- LLM / 画像ストレージ ------------------------------------------
# 【Aパターン：Manus Forge を使う場合（既定）】
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=Forge発行のキー

# 【Bパターン：Manus外で直接プロバイダを使う場合】
# 以下のいずれかを設定すると Forge より優先されます。
# OpenAI を使う場合:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o
# Google Gemini を使う場合:
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=...
#   GEMINI_MODEL=gemini-2.0-flash

# 画像ストレージ
# 【Aパターン：Manus Forge ストレージ（既定、上記Forge設定を使用）】
# 【Bパターン：S3互換ストレージ】
#   STORAGE_PROVIDER=s3
#   STORAGE_S3_BUCKET=hazemoto-app
#   STORAGE_S3_REGION=ap-northeast-1
#   STORAGE_S3_ACCESS_KEY_ID=...
#   STORAGE_S3_SECRET_ACCESS_KEY=...
#   STORAGE_S3_ENDPOINT=                 # MinIO等の場合のみ
#   STORAGE_S3_PUBLIC_URL_BASE=https://cdn.example.com   # 任意：CDN経由配信

# --- 認証（Manus OAuth） -------------------------------------------
# Manus環境外で動かす場合、別の認証へ差し替えが必要です
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OAUTH_SERVER_URL=https://oauth.manus.im
OWNER_OPEN_ID=社長アカウントのOpenID

# --- アナリティクス（任意）------------------------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- サーバー設定 --------------------------------------------------
NODE_ENV=production
PORT=3000
