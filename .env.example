# ===== sns-automation-app 環境変数テンプレート =====
# このファイルを .env にコピーして値を入れてください（.env は Git に上がりません）
#   cp .env.example .env

# --- 必須 ---
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME
JWT_SECRET=ランダムな長い文字列（setup-mac.sh が自動生成します）

# --- 認証（Manus OAuth）---
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- AI / ストレージ（Manus Forge API）---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Google（Googleフォト連携）---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_MAPS_API_KEY=

# --- Chatwork（大工チームランキング）---
CHATWORK_API_TOKEN=
CHATWORK_RANKING_ENABLED=false
CHATWORK_RANKING_INCLUDE_SELF=
CHATWORK_RANKING_EXCLUDE_IDS=
CHATWORK_DAIKU_ROOM_ID=
CHATWORK_DAIKU_ROOM_NAME=

# --- その他 ---
PORT=3000
